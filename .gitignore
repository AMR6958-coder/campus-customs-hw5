.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
frontend/node_modules/
frontend/dist/

# Claude desktop app: only the launch config is tracked
.claude/*
!.claude/launch.json

# Editors / OS
.DS_Store
Thumbs.db
