# Copy this file to backend/.env and fill in the key. backend/.env is git-ignored.

# LLM access: the Portkey gateway, which forwards OpenAI-compatible requests.
PORTKEY_API_KEY=replace-me-with-your-portkey-key
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Shop rule 10: every agent uses this one model. The back end refuses any other value.
OPENAI_MODEL=gpt-6-luna

# The MCP server (HTTP copy, started with `python -m mcp_server.server`).
MCP_URL=http://127.0.0.1:8100/mcp
